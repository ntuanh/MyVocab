# Settings for running MyVocab on your own computer (install.bat, ./run.sh).
# run.py copies this file to .env the first time, and its setup page fills in
# the keys. To change them, edit .env (never this file) or run install.bat again.
# Copy each value from Vercel -> Project Settings -> Environment Variables.
# .env is in .gitignore, so your keys never reach GitHub.

# PostgreSQL connection string. Without it the app opens, but saving words,
# the exam and practice cannot work.
DATABASE_URL=

# Any long random text. Signs the login cookie for the My Words page.
FLASK_SECRET_KEY=

# The password for the My Words page.
VIEW_DATA_PASSWORD=

# Google AI Studio key: definitions, Vietnamese meanings and practice marking.
GEMINI_API_KEY=

# Optional: pictures for each word.
PEXELS_API_KEY=
